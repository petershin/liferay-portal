Bundle-Name: Liferay Social Activities Taglib
Bundle-SymbolicName: com.liferay.social.activities.taglib
Bundle-Version: 2.0.0
Export-Package: com.liferay.social.activities.taglib.servlet.taglib
Provide-Capability:\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://liferay.com/tld/social-activities";\
		version:Version="${Bundle-Version}"
Require-Capability:\
	osgi.extender;\
		filter:="(&(osgi.extender=jsp.taglib)(uri=http://liferay.com/tld/frontend))"
Web-ContextPath: /social-activities-taglib
<?xml version="1.0"?>

<project basedir="." default="compile" name="util-bridges">
	<import file="../build-common-java.xml" />

	<property name="deploy.dir" value="${app.server.lib.portal.dir}" />
	<property name="jar.file" value="${ant.project.name}" />
	<property name="javac.classpathref" value="web.classpath" />
	<property name="manifest.bundle.name" value="Liferay Util Bridges" />
	<property name="manifest.bundle.symbolic.name" value="com.liferay.util.bridges" />

	<path id="web-lib.classpath">
		<pathelement path="${project.dir}/portal-kernel/classes" />
		<pathelement path="${project.dir}/util-java/classes" />
		<fileset
			dir="${project.dir}/lib/development"
			includes="groovy.jar,jruby.jar"
		/>
		<fileset
			dir="${project.dir}/lib/portal"
			includes="bsf.jar,commons-logging.jar,liferay-rhino.jar"
		/>
	</path>

	<target name="deploy">
		<if>
			<or>
				<equals arg1="${build.com.liferay.portal.snapshots}" arg2="true" />
				<equals arg1="${build.com.liferay.util.bridges.version}" arg2=""/>
			</or>
			<then>
				<ant antfile="${project.dir}/build-common-java.xml" dir="${project.dir}/util-bridges" inheritRefs="true" target="deploy" />
			</then>
			<else>
				<gradle-execute setupbinariescache="false" task="deployGroupPortalProject">
					<arg value="--build-file=${project.dir}/modules/util.gradle" />
					<arg value="-PdependencyName=${manifest.bundle.symbolic.name}" />
					<arg value="-PdeployDir=${deploy.dir}" />
					<arg value="-PprojectName=${ant.project.name}" />
				</gradle-execute>
			</else>
		</if>
	</target>

	<target depends="build-common-java.jar" name="jar">
		<copy
			file="${jar.file}.jar"
			preservelastmodified="true"
			todir="${portal-impl.classes.dir}/com/liferay/portal/deploy/dependencies"
		/>
	</target>
</project>